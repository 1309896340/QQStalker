# PostgreSQL container settings. Copy this file to .env before starting Docker.
POSTGRES_DB=qqstalker
POSTGRES_USER=qqstalker
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_PORT=8002

# NapCat OneBot 11 WebSocket Server settings. Keep the token only in .env.
NAPCAT_WS_SCHEME=ws
NAPCAT_WS_HOST=127.0.0.1
NAPCAT_WS_PORT=3001
NAPCAT_WS_PATH=/
NAPCAT_WS_TOKEN=replace-with-your-napcat-token
# Comma-separated group IDs. Leave empty to deny every group.
NAPCAT_ALLOWED_GROUP_IDS=123456789
# Docker Compose uses this host gateway instead of NAPCAT_WS_HOST=127.0.0.1.
NAPCAT_DOCKER_WS_HOST=host.docker.internal
# The FastAPI operational API accepts loopback addresses only.
NAPCAT_API_HOST=127.0.0.1
NAPCAT_API_PORT=8010
NAPCAT_CONNECT_TIMEOUT_SECONDS=10
NAPCAT_RECONNECT_INITIAL_SECONDS=1
NAPCAT_RECONNECT_MAX_SECONDS=30

# OpenAI-compatible LLM settings. Keep the API key only in your local .env.
# Ark's ordinary Chat Completions endpoint is https://ark.cn-beijing.volces.com/api/v3.
# Do not use its /api/plan/v3 endpoint unless LLM_MODEL supports Ark Agent Plan.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=replace-with-your-api-key

# Optional safeguards for long transcript analysis. LLM_TIMEOUT_SECONDS is the
# maximum time to wait for one model response; increase it for slow providers.
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=300
# Streaming (SSE) responses keep the connection active during long generations
# and avoid gateway idle disconnects. Set to false only for endpoints without
# SSE support, which falls back to the legacy non-streaming request path.
LLM_STREAM=true
# Retry transient network timeouts, rate limits, and HTTP 5xx responses. The
# wait begins at LLM_RETRY_DELAY_SECONDS and doubles before each retry.
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=2
LLM_MEMBERS_PER_REQUEST=6
LLM_MAX_INPUT_CHARACTERS=24000
# 最多展示的讨论议题数；超出部分按热度排序后忽略。
LLM_MAX_DISCUSSION_TOPICS=5
# 讨论纪要相互独立的模型请求（分段识别议题、逐题撰写纪要）的最大并发数。
LLM_DISCUSSION_CONCURRENCY=4
# 群员画像批次（按成员清单切分后的独立请求）的最大并发数；设为 1 保持串行。
LLM_PORTRAIT_CONCURRENCY=2
# 思考模式开关，仅对支持 thinking 请求字段的大模型生效（如 GLM、豆包系列）。
# 思维链输出是讨论纪要等长任务耗时的主要来源；设为 disabled 可大幅缩短等待。
# 留空或注释掉则不向请求注入 thinking 字段。可选值：enabled / disabled。
#LLM_THINKING=disabled
LLM_CONTEXT_MESSAGES_BEFORE=3
LLM_CONTEXT_MESSAGES_AFTER=3
LLM_MAX_CONTEXT_WINDOWS_PER_MEMBER=12
LLM_MAX_CONTEXT_CHARACTERS_PER_MEMBER=12000

# Optional PNG rendering settings. Taller output is split into numbered images.
PNG_DPI=300
PNG_MAX_HEIGHT_PIXELS=30000
