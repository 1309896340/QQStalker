# PostgreSQL container settings. Copy this file to .env before starting Docker.
POSTGRES_DB=qqstalker
POSTGRES_USER=qqstalker
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_PORT=5432
# Use "postgres" when the importer runs in another Docker container.
POSTGRES_HOST=localhost
# Optional: overrides the individual POSTGRES_* settings for the importer.
DATABASE_URL=
