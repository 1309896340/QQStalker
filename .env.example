# PostgreSQL container settings. Copy this file to .env before starting Docker.
POSTGRES_DB=qqstalker
POSTGRES_USER=qqstalker
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_PORT=8002

# OpenAI-compatible LLM settings. Keep the API key only in your local .env.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=replace-with-your-api-key

# Optional safeguards for long transcript analysis.
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=300
LLM_MEMBERS_PER_REQUEST=6
LLM_MAX_INPUT_CHARACTERS=24000

# Optional PNG rendering settings. Taller output is split into numbered images.
PNG_DPI=300
PNG_MAX_HEIGHT_PIXELS=30000
