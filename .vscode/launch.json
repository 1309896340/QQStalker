{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "读取json上传数据库",
      "type": "debugpy",
      "request": "launch",
      "module": "src.import_export",
      "args": [
        "${workspaceFolder}/data/电影迷交流群"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "从数据库筛选导出消息记录",
      "type": "debugpy",
      "request": "launch",
      "module": "src.export_markdown",
      "args": [
        "2026-09-09",
        "${workspaceFolder}/exports",
        "--end-date",
        "2026-09-10"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "AI 分析群员画像",
      "type": "debugpy",
      "request": "launch",
      "module": "src.analyze_transcript",
      "args": [
        "${workspaceFolder}/exports/20260910233118_消息记录.md",
        "${workspaceFolder}/analysis"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "将群员画像 HTML 渲染为 PNG",
      "type": "debugpy",
      "request": "launch",
      "module": "src.render_html_png",
      "args": [
        "${workspaceFolder}/analysis/20260911003736_群员画像.html",
        "${workspaceFolder}/analysis/20260911003736_群员画像.png",
        "--dpi",
        "300",
        "--width-mm",
        "210"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
